# Basis data lokal SQLite (path relatif terhadap prisma/schema.prisma)
DATABASE_URL="file:./dev.db"
# Produksi (PostgreSQL 16):
# DATABASE_URL="postgresql://postgres:password@localhost:5432/siriset_db?schema=public"

# Kunci enkripsi cookie sesi (minimal 32 karakter acak). Ganti untuk produksi.
SESSION_SECRET="ganti-dengan-string-acak-minimal-32-karakter"

# Aktifkan pintasan "Masuk sebagai akun demo" di Role Switcher (matikan di produksi)
DEMO_MODE="true"

# Mock adapter integrasi eksternal
SIAKAD_API_MOCK_ENABLED="true"
SIAKAD_API_ENDPOINT="https://api-mock.trunojoyo.ac.id/siakad/v1"
SIMPELMAS_API_MOCK_ENABLED="true"
SIMPELMAS_API_ENDPOINT="https://api-mock.trunojoyo.ac.id/simpelmas/v1"

# Penyimpanan berkas (di luar public/ — diunduh lewat route terotorisasi)
UPLOAD_DIR="./storage/uploads"
MAX_FILE_SIZE_MB="5"

# Kunci HMAC stempel digital QR lembar pengesahan (jangan diganti setelah dokumen terbit)
DOCUMENT_SIGNING_SECRET="ganti-dengan-string-acak-minimal-32-karakter"

# URL dasar aplikasi untuk tautan verifikasi QR lembar pengesahan (opsional, default http://localhost:3000)
# APP_URL="http://localhost:3000"
